{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "labels": [
        "changelog:dependencies"
    ],
    "branchConcurrentLimit": 1,
    "dependencyDashboard": false,
    "minimumReleaseAge": "3 days",
    "reviewersFromCodeOwners": true,
    "semanticCommits": "enabled",
    "hostRules": [
        {
            "matchHost": "github.com",
            "hostType": "github",
            "token": "{{ secrets.BLUEBEETLE_BOT_PAT }}"
        },
        {
            "matchHost": "github.com",
            "hostType": "packagist",
            "token": "{{ secrets.BLUEBEETLE_BOT_PAT }}"
        },
        {
            "matchHost": "packages.eufaturo.pt",
            "hostType": "packagist",
            "username": "eufaturo",
            "password": "{{ secrets.SATIS_PASSWORD }}"
        },
        {
            "matchHost": "https://npm.pkg.github.com/",
            "hostType": "npm",
            "token": "{{ secrets.BLUEBEETLE_BOT_PAT }}"
        }
    ],
    "packageRules": [
        {
            "description": "Runtime versions managed via docker-dev bump scripts",
            "matchDepNames": [
                "php",
                "node",
                "@types/node",
                "pnpm",
                "npm",
                "serversideup/php"
            ],
            "enabled": false
        },
        {
            "description": "Pest pins PHPUnit and Collision, so they move together",
            "groupName": "Pest and PHPUnit",
            "matchPackageNames": [
                "pestphp/{/,}**",
                "phpunit/phpunit",
                "nunomaduro/collision"
            ]
        },
        {
            "description": "Testbench follows the Laravel version it targets",
            "groupName": "Laravel and Testbench",
            "matchPackageNames": [
                "laravel/framework",
                "orchestra/testbench{/,}**"
            ]
        },
        {
            "description": "Pest 4 runs on PHPUnit 12",
            "matchPackageNames": [
                "phpunit/phpunit"
            ],
            "allowedVersions": "<13"
        }
    ]
}
